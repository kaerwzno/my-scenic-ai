.page { padding: 32rpx 28rpx 60rpx; }
.head { margin-bottom: 28rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 10rpx; }
.center { text-align: center; }
.err { color: #C1604C; font-size: 26rpx; line-height: 1.6; }

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.card {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06);
}

.card.on { border-color: #4E327D; }

.portrait {
  width: 100%;
  height: 330rpx;
  display: block;
  background: #efe9dd;
}

.name { font-size: 30rpx; font-weight: 600; padding: 14rpx 16rpx 0; }
.tagline { font-size: 22rpx; color: #8a8378; padding: 4rpx 16rpx 16rpx; line-height: 1.4; }

.badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  background: #4E327D;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.foot { margin-top: 40rpx; }
.mt { margin-top: 18rpx; }
