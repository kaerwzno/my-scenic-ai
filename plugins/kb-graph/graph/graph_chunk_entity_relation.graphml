  <data key="d6"></data>
</node>
<node id="飞天">
  <data key="d0">飞天</data>
  <data key="d1">creature</data>
  <data key="d2">飞天是雕刻在五明桥上的佛教图案之一。&lt;SEP&gt;佛教神话中的天人，其形象被雕刻在五明桥的桥栏上。</data>
  <data key="d3">chunk-74e725259e25a64936e3bc1bb9a351d2&lt;SEP&gt;chunk-603ffd611f97b0f02a39958fef001241</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778820415</data>
  <data key="d6"></data>
</node>
<node id="神兽">
  <data key="d0">神兽</data>
  <data key="d1">creature</data>
  <data key="d2">神兽是雕刻在五明桥上的佛教图案之一。&lt;SEP&gt;神话中的动物，其形象被雕刻在五明桥的桥栏上。</data>
  <data key="d3">chunk-74e725259e25a64936e3bc1bb9a351d2&lt;SEP&gt;chunk-603ffd611f97b0f02a39958fef001241</data>
  <data key="d4">unknown_source</data>
